    <!-- ===== CONTACT + GOOGLE MAPS ===== -->
    <section id="contacto" class="py-section bg-white">
      <div class="container">
        <div class="text-center mb-5">
          <span class="section-label">Contact</span>
          <h2 class="section-title">Where to find us</h2>
        </div>

        <div class="row g-5">

          <!-- Map -->
          <div class="col-lg-7">
            <div class="map-wrapper">
              <iframe
                data-maps-embed
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d196635.93878450102!2d2.8838303093940323!3d39.63988895584924!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12963f4c3087a2ff%3A0x6cea15f041fc2041!2sJetExperience%20Baleares!5e0!3m2!1ses!2ses!4v1778668418112!5m2!1ses!2ses"
                width="100%"
                height="400"
                style="border:0; border-radius:16px;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="JetExperience Baleares location Cala Millor">
              </iframe>
            </div>
            <div class="contact-info mt-4">
              <div class="contact-info__item">
                <span>📍</span>
                <span>Avenida del Pinar 43, Costa de los Pinos, Cala Millor</span>
              </div>
              <div class="contact-info__item">
                <span>✉️</span>
                <span data-email class="contact-link">info@jetexperiencemallorca.com</span>
              </div>
              <a data-maps-url href="https://share.google/Q987VDnOacnBXAkCH" class="btn-cta mt-3 d-inline-block">Get directions</a>
            </div>
          </div>

          <!-- Form -->
          <div class="col-lg-5">
            <h3 class="section-title mb-4" style="font-size:1.4rem">Get in touch</h3>
            <form class="contact-form" id="contact-form" novalidate>
              <!-- Honeypot -->
              <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off">
              <!-- Phone hidden: contact always via WhatsApp -->
              <input type="hidden" name="phone" id="contact-phone" value="WhatsApp">

              <div class="mb-3">
                <label for="contact-name" class="form-label fw-semibold">Name</label>
                <input id="contact-name" type="text" name="name" class="form-control contact-input" required
                  placeholder="Name">
                <div class="invalid-feedback">Please enter your name.</div>
              </div>
              <div class="mb-3">
                <label for="contact-date" class="form-label fw-semibold">Desired date</label>
                <input id="contact-date" type="date" name="date" class="form-control contact-input">
                <div class="invalid-feedback">The date cannot be in the past.</div>
              </div>
              <div class="mb-3">
                <label for="contact-experience" class="form-label fw-semibold">Type of experience</label>
                <select id="contact-experience" name="experience" class="form-select contact-input">
                  <option value="">Type of experience</option>
                  <option value="classic">Popular – 1h · 110€</option>
                  <option value="private">Special Pack – 2h · 185€</option>
                  <option value="family">Family Route – 4h · 275€</option>
                </select>
              </div>
              <div class="mb-4">
                <label for="contact-message" class="form-label fw-semibold">Message</label>
                <textarea id="contact-message" name="message" rows="4" class="form-control contact-input"
                  placeholder="Message"></textarea>
              </div>
              <button type="submit" class="btn-cta w-100">Send via WhatsApp</button>
            </form>
          </div>

        </div>
      </div>
    </section>
