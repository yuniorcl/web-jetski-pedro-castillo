  {% set homePath = '/en/' if currentLang == 'en' else '/' %}
  <header id="site-header" class="site-header">
      <div class="container-fluid px-4">
        <nav class="navbar navbar-expand-lg p-0">

          <!-- Logo -->
          <a class="navbar-brand logo-link" href="{{ homePath }}">
            <img src="/assets/img/logo.jpeg" alt="JetExperience Baleares"
              style="height:54px; width:54px; border-radius:50%; object-fit:cover;">
          </a>

          <!-- Mobile toggle -->
          <button class="navbar-toggler border-0 text-white" type="button"
            data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
          </button>

          <!-- Nav links -->
          <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
              <li class="nav-item"><a class="nav-link" href="{{ homePath }}#hero" data-i18n="nav.home">{% if currentLang == 'en' %}Home{% else %}Inicio{% endif %}</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ homePath }}#experiencias" data-i18n="nav.prices">{% if currentLang == 'en' %}Prices{% else %}Tarifas{% endif %}</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ homePath }}#galeria" data-i18n="nav.gallery">{% if currentLang == 'en' %}Gallery{% else %}Galería{% endif %}</a></li>
              <li class="nav-item"><a class="nav-link" href="{{ homePath }}#contacto" data-i18n="nav.contact">{% if currentLang == 'en' %}Contact{% else %}Contacto{% endif %}</a></li>
              <li class="nav-item ms-lg-2">
                <a class="btn-cta btn-cta--sm" href="{{ homePath }}#contacto" data-i18n="nav.book">{% if currentLang == 'en' %}Book now{% else %}Reservar ahora{% endif %}</a>
              </li>
              <!-- Language switcher -->
              <li class="nav-item ms-lg-2">
                <div class="lang-switcher">
                  <a href="{{ langEs }}" class="lang-btn{% if currentLang == 'es' %} active{% endif %}">ES</a>
                  <span class="lang-sep">|</span>
                  <a href="{{ langEn }}" class="lang-btn{% if currentLang == 'en' %} active{% endif %}">EN</a>
                </div>
              </li>
            </ul>
          </div>

        </nav>
      </div>
  </header>
