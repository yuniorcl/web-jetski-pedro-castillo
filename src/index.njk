    <!-- ===== CONTACTO + GOOGLE MAPS ===== -->
    <section id="contacto" class="py-section bg-white">
      <div class="container">
        <div class="text-center mb-5">
          <span class="section-label" data-i18n="contact.label">Contacto</span>
          <h2 class="section-title" data-i18n="contact.title">¿Dónde estamos?</h2>
        </div>

        <div class="row g-5">

          <!-- Mapa -->
          <div class="col-lg-7">
            <div class="map-wrapper">
              <iframe
                data-maps-embed
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d196635.93878450102!2d2.8838303093940323!3d39.63988895584924!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12963f4c3087a2ff%3A0x6cea15f041fc2041!2sJetExperience%20Baleares!5e0!3m2!1ses!2ses!4v1778668418112!5m2!1ses!2ses"
                width="100%"
                height="400"
                style="border:0; border-radius:16px;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="JetExperience Baleares location Cala Millor">
              </iframe>
            </div>
            <div class="contact-info mt-4">
              <div class="contact-info__item">
                <span>📍</span>
                <span data-i18n="contact.address">Avenida del Pinar 43, Costa de los Pinos, Cala Millor</span>
              </div>
              <div class="contact-info__item">
                <span>✉️</span>
                <span data-email class="contact-link">info@jetexperiencemallorca.com</span>
              </div>
              <a data-maps-url href="https://share.google/Q987VDnOacnBXAkCH" class="btn-cta mt-3 d-inline-block" data-i18n="contact.howto">Cómo llegar</a>
            </div>
          </div>

          <!-- Formulario -->
          <div class="col-lg-5">
            <h3 class="section-title mb-4" style="font-size:1.4rem" data-i18n="contact.form.title">¿Hablamos?</h3>
            <form class="contact-form" id="contact-form" novalidate>
              <!-- Honeypot -->
              <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off">
              <!-- Phone hidden: contact always via WhatsApp -->
              <input type="hidden" name="phone" id="contact-phone" value="WhatsApp">

              <div class="mb-3">
                <label for="contact-name" class="form-label fw-semibold" data-i18n="contact.form.name">Nombre</label>
                <input id="contact-name" type="text" name="name" class="form-control contact-input" required
                  data-i18n-placeholder="contact.form.name" placeholder="Nombre">
                <div class="invalid-feedback" data-i18n="contact.form.error.name">Por favor, indica tu nombre.</div>
              </div>
              <div class="mb-3">
                <label for="contact-date" class="form-label fw-semibold" data-i18n="contact.form.date">Fecha deseada</label>
                <input id="contact-date" type="date" name="date" class="form-control contact-input">
                <div class="invalid-feedback" data-i18n="contact.form.error.date">La fecha no puede ser anterior a hoy.</div>
              </div>
              <div class="mb-3">
                <label for="contact-experience" class="form-label fw-semibold" data-i18n="contact.form.experience">Tipo de experiencia</label>
                <select id="contact-experience" name="experience" class="form-select contact-input">
                  <option value="" data-i18n="contact.form.experience">Tipo de experiencia</option>
                  <option value="classic" data-i18n="contact.form.exp.classic">Popular – 1h · 130€</option>
                  <option value="private" data-i18n="contact.form.exp.private">Pack Especial – 2h · 200€</option>
                  <option value="family" data-i18n="contact.form.exp.family">En Familia – 4h · 300€</option>
                </select>
              </div>
              <div class="mb-4">
                <label for="contact-message" class="form-label fw-semibold" data-i18n="contact.form.message">Mensaje</label>
                <textarea id="contact-message" name="message" rows="4" class="form-control contact-input"
                  data-i18n-placeholder="contact.form.message" placeholder="Mensaje"></textarea>
              </div>
              <button type="submit" class="btn-cta w-100" data-i18n="contact.form.submit">Enviar por WhatsApp</button>
            </form>
          </div>

        </div>
      </div>
    </section>
